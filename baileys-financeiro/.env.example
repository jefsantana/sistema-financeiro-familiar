# Chave da API da Anthropic (console.anthropic.com) — precisa ser uma chave
# escopada a um workspace específico, não uma chave "Organization"-wide.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado para interpretar as mensagens do grupo
ANTHROPIC_MODEL=claude-sonnet-5

# URL do projeto Supabase
SUPABASE_URL=https://smptdvscrudvclawdmla.supabase.co

# Service role key do Supabase (Project Settings > API) — bypassa RLS
SUPABASE_SERVICE_KEY=

# Chave da OpenAI (platform.openai.com), usada só para transcrever mensagens
# de áudio via Whisper. Opcional: sem ela, áudios são apenas ignorados
# (texto e foto de comprovante continuam funcionando normalmente).
OPENAI_API_KEY=

# Token exigido no header x-send-token do endpoint manual POST /enviar
SEND_TOKEN=troque-este-token

# Nome exato do grupo do WhatsApp a ser monitorado
NOME_GRUPO_ALVO=CONTROLE FINANCEIRO

# UUID da família no Supabase (tabela "familias")
FAMILIA_ID=11111111-1111-1111-1111-111111111111

# Fuso horário usado nos agendamentos (saldo diário, avisos de contas a vencer)
FUSO_HORARIO=America/Sao_Paulo

# Porta HTTP interna (healthcheck do Fly.io + endpoints /status e /enviar)
PORT=8080
