# Chave da API da Anthropic (console.anthropic.com) — precisa ser uma chave
# escopada a um workspace específico, não uma chave "Organization"-wide.
# É o último provedor da cadeia de fallback (o único pago entre os quatro).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Cadeia de fallback de interpretação: o bot tenta cada provedor abaixo na
# ordem (gratuitos primeiro) e só cai pra Anthropic (pago) se todos os
# outros falharem ou não estiverem configurados. Groq e Mistral só leem
# texto (sem foto de comprovante); Gemini, OpenAI e Anthropic leem imagem.
# Aceita várias chaves separadas por vírgula (uma por projeto Google Cloud —
# cada projeto tem cota gratuita própria). Ex: "chave1,chave2,chave3".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# URL do projeto Supabase
SUPABASE_URL=https://smptdvscrudvclawdmla.supabase.co

# Service role key do Supabase (Project Settings > API) — bypassa RLS
SUPABASE_SERVICE_KEY=

# Chave da OpenAI (platform.openai.com) — usada tanto para transcrever
# mensagens de áudio via Whisper quanto como um dos provedores na cadeia de
# fallback acima. Opcional: sem ela, áudios são ignorados e ela só é pulada
# na cadeia (texto e foto de comprovante continuam funcionando normalmente).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Token exigido no header x-send-token do endpoint manual POST /enviar
SEND_TOKEN=troque-este-token

# Nome exato do grupo do WhatsApp a ser monitorado
NOME_GRUPO_ALVO=CONTROLE FINANCEIRO

# UUID da família no Supabase (tabela "familias")
FAMILIA_ID=11111111-1111-1111-1111-111111111111

# Fuso horário usado nos agendamentos (saldo diário, avisos de contas a vencer)
FUSO_HORARIO=America/Sao_Paulo

# Porta HTTP interna (healthcheck do Fly.io + endpoints /status e /enviar)
PORT=8080
