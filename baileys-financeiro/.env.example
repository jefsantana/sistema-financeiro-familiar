# URL do webhook do workflow "Financeiro - WhatsApp para Supabase (IA)" no n8n
# Pegue em: n8n -> abra o workflow -> node "Baileys - Mensagem Recebida" -> aba "Production URL"
N8N_WEBHOOK_URL=https://jefsantana.app.n8n.cloud/webhook/financeiro-whatsapp

# Nome exato do grupo de WhatsApp a escutar (deixe em branco na primeira execução
# para o bot listar os grupos que ele vir e você copiar o nome certo daqui)
WHATSAPP_GROUP_NAME=CONTROLE FINANCEIRO

# Alternativa ao nome: o ID do grupo (ex: 120363012345678901@g.us). Se preenchido, tem prioridade.
WHATSAPP_GROUP_ID=

# Pasta onde a sessão autenticada do WhatsApp é salva. No Railway, aponte para
# o volume persistente (ex: /data/auth_info) para não precisar escanear o QR
# de novo a cada deploy.
AUTH_DIR=./auth_info
